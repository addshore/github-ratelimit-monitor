# TODO: Create a GitHub OAuth App at https://github.com/settings/developers
# - Set "Homepage URL" to your Cloudflare Pages URL (e.g. https://your-app.pages.dev)
# - Set "Authorization callback URL" to https://your-app.pages.dev/api/auth/callback
# - Copy the Client ID here:
VITE_GITHUB_CLIENT_ID=your_github_oauth_client_id_here

# Client Secret — needed locally so the dev server can exchange the OAuth code.
# This is NOT exposed to the browser (no VITE_ prefix).
# For production, set it as a secret in the Cloudflare Pages dashboard instead.
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here

# --- Cloudflare Pages (production) ---
# In dashboard → Settings → Environment variables, add:
#   GITHUB_CLIENT_ID     = <your client id>
#   GITHUB_CLIENT_SECRET = <your client secret>
